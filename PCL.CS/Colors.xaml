<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    
    <!--#region 通用颜色表-->
    <Color x:Key="ColorObject1">#343d4a</Color>
    <Color x:Key="ColorObject2">#0b5bcb</Color>
    <Color x:Key="ColorObject3">#1370f3</Color>
    <Color x:Key="ColorObject4">#4890f5</Color>
    <Color x:Key="ColorObject5">#96c0f9</Color>
    <Color x:Key="ColorObject6">#d5e6fd</Color>
    <Color x:Key="ColorObject7">#e0eafd</Color>
    <Color x:Key="ColorObject8">#eaf2fe</Color>
    <Color x:Key="ColorObjectBg0">#96c0f9</Color>
    <Color x:Key="ColorObjectBg1">#bee0eafd</Color>
    <Color x:Key="ColorObjectGray1">#404040</Color>
    <Color x:Key="ColorObjectGray2">#737373</Color>
    <Color x:Key="ColorObjectGray3">#8c8c8c</Color>
    <Color x:Key="ColorObjectGray4">#a6a6a6</Color>
    <Color x:Key="ColorObjectGray5">#cccccc</Color>
    <Color x:Key="ColorObjectGray6">#ebebeb</Color>
    <Color x:Key="ColorObjectGray7">#f0f0f0</Color>
    <Color x:Key="ColorObjectGray8">#f5f5f5</Color>
    <Color x:Key="ColorObjectRedBack">#80fbdddd</Color>
    <Color x:Key="ColorObjectRedLight">#ff4c4c</Color>
    <Color x:Key="ColorObjectRedDark">#ce2111</Color>
    <Color x:Key="ColorObjectHalfWhite">#55ffffff</Color>
    <Color x:Key="ColorObjectSemiWhite">#bbffffff</Color>
    <Color x:Key="ColorObjectWhite">#ffffff</Color>
    <Color x:Key="ColorObjectTransparent">Transparent</Color>
    <Color x:Key="ColorObjectSemiTransparent">#01eaf2fe</Color>
    <Color x:Key="ColorObjectBackgroundTransparentSidebar">#CCFFFFFF</Color>

    <SolidColorBrush x:Key="ColorBrush1" Color="{DynamicResource ColorObject1}"/>
    <SolidColorBrush x:Key="ColorBrush2" Color="{DynamicResource ColorObject2}"/>
    <SolidColorBrush x:Key="ColorBrush3" Color="{DynamicResource ColorObject3}"/>
    <SolidColorBrush x:Key="ColorBrush4" Color="{DynamicResource ColorObject4}"/>
    <SolidColorBrush x:Key="ColorBrush5" Color="{DynamicResource ColorObject5}"/>
    <SolidColorBrush x:Key="ColorBrush6" Color="{DynamicResource ColorObject6}"/>
    <SolidColorBrush x:Key="ColorBrush7" Color="{DynamicResource ColorObject7}"/>
    <SolidColorBrush x:Key="ColorBrush8" Color="{DynamicResource ColorObject8}"/>
    <SolidColorBrush x:Key="ColorBrushBg0" Color="{DynamicResource ColorObjectBg0}"/>
    <SolidColorBrush x:Key="ColorBrushBg1" Color="{DynamicResource ColorObjectBg1}"/>

    <SolidColorBrush x:Key="ColorBrushGray1" Color="{DynamicResource ColorObjectGray1}"/>
    <SolidColorBrush x:Key="ColorBrushGray2" Color="{DynamicResource ColorObjectGray2}"/>
    <SolidColorBrush x:Key="ColorBrushGray3" Color="{DynamicResource ColorObjectGray3}"/>
    <SolidColorBrush x:Key="ColorBrushGray4" Color="{DynamicResource ColorObjectGray4}"/>
    <SolidColorBrush x:Key="ColorBrushGray5" Color="{DynamicResource ColorObjectGray5}"/>
    <SolidColorBrush x:Key="ColorBrushGray6" Color="{DynamicResource ColorObjectGray6}"/>
    <SolidColorBrush x:Key="ColorBrushGray7" Color="{DynamicResource ColorObjectGray7}"/>
    <SolidColorBrush x:Key="ColorBrushGray8" Color="{DynamicResource ColorObjectGray8}"/>

    <SolidColorBrush x:Key="ColorBrushRedBack" Color="{DynamicResource ColorObjectRedBack}"/>
    <SolidColorBrush x:Key="ColorBrushRedLight" Color="{DynamicResource ColorObjectRedLight}"/>
    <SolidColorBrush x:Key="ColorBrushRedDark" Color="{DynamicResource ColorObjectRedDark}"/>
    <SolidColorBrush x:Key="ColorBrushHalfWhite" Color="{DynamicResource ColorObjectHalfWhite}" />
    <SolidColorBrush x:Key="ColorBrushSemiWhite" Color="{DynamicResource ColorObjectSemiWhite}" />
    <SolidColorBrush x:Key="ColorBrushWhite" Color="{DynamicResource ColorObjectWhite}" />
    <SolidColorBrush x:Key="ColorBrushTransparent" Color="Transparent" />
    <SolidColorBrush x:Key="ColorBrushSemiTransparent">#01eaf2fe</SolidColorBrush>
    <SolidColorBrush x:Key="ColorBrushBackgroundTransparentSidebar" Color="{DynamicResource ColorObjectBackgroundTransparentSidebar}" />
    
    <!--#endregion-->
</ResourceDictionary>