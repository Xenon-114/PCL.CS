<local:MyPageRight x:Class="PCL.CS.Pages.PageAbout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PCL.CS.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <local:MyScrollViewer x:Name="MainAScrollViewer">
            <StackPanel x:Name="MainScrollViewer">
                <local:MyButton Height="40" Margin="20,20,150,20" Text="普通按钮"/>
                <local:MyButton Height="40" Margin="20,0,20,20" Text="高亮按钮" ColorType="Highlight"/>
                <local:MyButton Height="40" Margin="20,0,20,20" Text="红色按钮" ColorType="Red" Click="MyButton_Click"/>
                <local:MyCard Margin="20,0,20,20" Title="卡片" CanSwap="True">
                    <TextBlock Text="折叠卡片里可以放内容"/>
                </local:MyCard>
                <Grid Margin="20,0,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>
                    <local:MyBorder Margin="20" Grid.Column="0" HorizontalAlignment="Center" x:Name="Loadingaaa">
                        <local:MyLoading Margin="20,0,20,0" />
                    </local:MyBorder>
                    <local:MyBorder Grid.Column="1" Margin="20">
                        <local:MyComboBox HorizontalAlignment="Center" Width="200" IsEditable="True" ToolTip="abc" VerticalAlignment="Center">
                            <local:MyComboBoxItem Content="这个东西可以选择"/>
                            <local:MyComboBoxItem Content="而且是互斥的"/>
                            <local:MyComboBoxItem Content="可以装很多..."/>
                            <local:MyComboBoxItem Content="很多很多..."/>
                            <local:MyComboBoxItem Content="很多很多..."/>
                            <local:MyComboBoxItem Content="很多很多..."/>
                            <local:MyComboBoxItem Content="很多很多..."/>
                            <local:MyComboBoxItem Content="很多很多..."/>
                            <local:MyComboBoxItem Content="很多很多..."/>
                            <local:MyComboBoxItem Content="很多很多..."/>
                            <local:MyComboBoxItem Content="很多很多..."/>
                            <local:MyComboBoxItem Content="...的东西"/>
                        </local:MyComboBox>
                    </local:MyBorder>
                </Grid>
                <local:MyCard Margin="20,0,20,20" Title="卡片" CanSwap="True" IsSwapped="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>
                        <local:MyButton Height="40" Grid.Column="0" ColorType="Highlight" Margin="10"/>
                        <local:MyButton Height="40" Grid.Column="1" ColorType="Red" Margin="10"/>
                    </Grid>
                </local:MyCard>
                <local:MyCard Margin="20,0,20,20" Title="卡片" CanSwap="True" IsSwapped="False">
                    <StackPanel>
                        <local:MyButton Height="40" Grid.Column="0" ColorType="Highlight" Margin="10"/>
                        <local:MyButton Height="40" Grid.Column="0" ColorType="Highlight" Margin="10"/>
                        <local:MyButton Height="40" Grid.Column="0" ColorType="Highlight" Margin="10"/>
                        <local:MyButton Height="40" Grid.Column="0" ColorType="Highlight" Margin="10"/>
                        <local:MyButton Height="40" Grid.Column="0" ColorType="Highlight" Margin="10"/>
                        <local:MyTextBox Hint="abc"/>
                        <local:MyListItem Height="50" AutoCheck="True"/>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyBorder HorizontalAlignment="Right" VerticalAlignment="Top" Height="50" Width="120" Margin="0,10,10,0" x:Name="ControlOver">
            <local:MyBorder.RenderTransform>
                <TranslateTransform/>
            </local:MyBorder.RenderTransform>
            <StackPanel Orientation="Horizontal" >
                <local:MyIconButton Height="36" Width="36" HorizontalAlignment="Left" Margin="10,7,0,7" Logo="M940.4 463.7L773.3 174.2c-17.3-30-49.2-48.4-83.8-48.4H340.2c-34.6 0-66.5 18.5-83.8 48.4L89.2 463.7c-17.3 30-17.3 66.9 0 96.8L256.4 850c17.3 30 49.2 48.4 83.8 48.4h349.2c34.6 0 66.5-18.5 83.8-48.4l167.2-289.5c17.3-29.9 17.3-66.8 0-96.8z m-94.6 96.8L725.9 768.1c-17.3 30-49.2 48.4-83.8 48.4H387.5c-34.6 0-66.5-18.5-83.8-48.4L183.9 560.5c-17.3-30-17.3-66.9 0-96.8l119.8-207.5c17.3-30 49.2-48.4 83.8-48.4h254.6c34.6 0 66.5 18.5 83.8 48.4l119.8 207.5c17.3 30 17.3 66.9 0.1 96.8z M522.3 321.2c-2.5-0.1-5-0.2-7.5-0.2-119.9 0-214 110.3-186.3 235 15.8 70.9 71.5 126.6 142.4 142.4 17.5 3.9 34.7 5.4 51.4 4.7 102.1-3.9 183.6-87.9 183.6-191 0.1-103-81.5-187-183.6-190.9z m68.6 269.1c-18.5 18-43 28.9-68.6 30.7l-6 0.3c-30.2 0.4-58.6-11.4-79.7-33-19.5-20.1-30.7-47-30.9-75-0.3-29.6 11.1-57.4 32-78.3 20.6-20.6 48-32 77.2-32 2.5 0 5 0.1 7.5 0.3 26.7 1.8 51.5 13.2 70.5 32.5 19.6 20 30.8 46.9 31.2 74.9 0.2 30.2-11.5 58.6-33.2 79.6z"
        ColorType="Color" IsEnabled="True" Click="MyIconButton_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="示例界面" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrush1}" FontSize="15" Opacity="0.9"/>
                    <TextBlock Text="该部分浮于滚动区上方" FontSize="7"/>
                </StackPanel>
            </StackPanel>
