<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
	<LangVersion>10.0</LangVersion>
	<Configurations>Debug;Release;Alpha;Beta</Configurations>
	<PlatformTarget>AnyCPU</PlatformTarget>
	<SignAssembly>False</SignAssembly>
	<ApplicationIcon>Image\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Alpha' ">
	<OutputPath>bin\Alpha\</OutputPath>
	<DefineConstants>ALPHA</DefineConstants>
	<Optimize>False</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Beta' ">
	<OutputPath>bin\Beta\</OutputPath>
	<DefineConstants>BETA</DefineConstants>
	<Optimize>False</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tools\**" />
    <EmbeddedResource Remove="Tools\**" />
    <None Remove="Tools\**" />
    <Page Remove="Tools\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="ImageGenBuilder.exe" />
    <None Remove="Image\Blocks\Anvil.png" />
    <None Remove="Image\Blocks\CobbleStone.png" />
    <None Remove="Image\Blocks\CommandBlock.png" />
    <None Remove="Image\Blocks\Egg.png" />
    <None Remove="Image\Blocks\Fabric.png" />
    <None Remove="Image\Blocks\GoldBlock.png" />
    <None Remove="Image\Blocks\Grass.png" />
    <None Remove="Image\Blocks\GrassPath.png" />
    <None Remove="Image\Blocks\NeoForge.png" />
    <None Remove="Image\Blocks\OptiFabric.png" />
    <None Remove="Image\Blocks\RedstoneBlock.png" />
    <None Remove="Image\Blocks\RedstoneLampOff.png" />
    <None Remove="Image\Blocks\RedstoneLampOn.png" />
    <None Remove="Image\Icons\Disabled.png" />
    <None Remove="Image\Icons\NoIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Image\Blocks\Anvil.png" />
    <EmbeddedResource Include="Image\Blocks\CobbleStone.png" />
    <EmbeddedResource Include="Image\Blocks\CommandBlock.png" />
    <EmbeddedResource Include="Image\Blocks\Egg.png" />
    <EmbeddedResource Include="Image\Blocks\Fabric.png" />
    <EmbeddedResource Include="Image\Blocks\GoldBlock.png" />
    <EmbeddedResource Include="Image\Blocks\Grass.png" />
    <EmbeddedResource Include="Image\Blocks\GrassPath.png" />
    <EmbeddedResource Include="Image\Blocks\NeoForge.png" />
    <EmbeddedResource Include="Image\Blocks\OptiFabric.png" />
    <EmbeddedResource Include="Image\Blocks\RedstoneBlock.png" />
    <EmbeddedResource Include="Image\Blocks\RedstoneLampOff.png" />
    <EmbeddedResource Include="Image\Blocks\RedstoneLampOn.png" />
    <Resource Include="Image\icon.ico" />
    <EmbeddedResource Include="Image\Icons\Disabled.png" />
    <EmbeddedResource Include="Image\Icons\NoIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XeF4Core.WPF\XeF4Core.WPF.csproj" />
    <ProjectReference Include="..\XeF4Core\XeF4Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controls\Test\" />
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Costura.Fody" Version="6.2.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <!-- 定义工具路径和参数 -->
    <ImageGenTool>$(MSBuildProjectDirectory)\Tools\ImageGenBuilder.exe</ImageGenTool>
    <ProjectPath>$(MSBuildProjectDirectory)</ProjectPath>
  </PropertyGroup>
  <Target Name="GenerateImagesXaml" BeforeTargets="BeforeBuild" Condition="Exists('$(ImageGenTool)')">
    <!-- 运行小工具，参数用空格分隔 -->
    <Exec Command="&quot;$(ImageGenTool)&quot; &quot;$(MSBuildProjectDirectory)&quot;" ContinueOnError="WarnAndContinue" StandardOutputImportance="High" />
  </Target>
</Project>
