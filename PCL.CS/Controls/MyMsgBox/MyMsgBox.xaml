<UserControl x:Class="PCL.CS.Controls.MyMsgBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PCL.CS.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="400" RenderTransformOrigin="0.5,0.5"
             UseLayoutRounding="True">
    <UserControl.RenderTransform>
        <TransformGroup>
            <TranslateTransform x:Name="Translate"/>
            <RotateTransform x:Name="Rotate"/>
        </TransformGroup>
    </UserControl.RenderTransform>
    <Border Background="#FBFBFB" CornerRadius="7" Focusable="True">
        <Border.Effect>
            <DropShadowEffect x:Name="Shadow" Color="{DynamicResource ColorObject1}" BlurRadius="20" ShadowDepth="4" RenderingBias="Performance" Opacity="0.8"/>
        </Border.Effect>
        <Grid>
            <Button Opacity="0" x:Name="BackBtn"/>
            <Grid Margin="22,22,22,23">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="13"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" FontSize="23" TextTrimming="None" Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Left" Name="LabTitle" Margin="7,-1,70,9" Text="测试标题文本" VerticalAlignment="Top" SnapsToDevicePixels="False" UseLayoutRounding="False" />
                <Rectangle Grid.Row="1" Height="2" Fill="{Binding Foreground, ElementName=LabTitle}" />
                <ContentPresenter Grid.Row="3" x:Name="PanContent"/>
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentControl x:Name="PanExtraContent" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <local:MyButton ColorType="Normal" x:FieldModifier="public" Text="按钮3" x:Name="Btn3" Margin="12,0,0,0" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" TextPadding="7"/>
                        <local:MyButton ColorType="Normal" x:FieldModifier="public" Text="按钮2" x:Name="Btn2" Margin="12,0,0,0" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" TextPadding="7"/>
                        <local:MyButton ColorType="Normal" x:FieldModifier="public" Text="按钮1" x:Name="Btn1" Margin="12,0,0,0" SnapsToDevicePixels="False" Padding="5,0" UseLayoutRounding="False" TextPadding="7"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
